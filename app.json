{
  "expo": {
    "name": "만버깅",
    "owner": "seoma",
    "slug": "pedometer",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/school-logo.png",
    "scheme": "pedometer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seoma.pedmeter",
      "googleServicesFile": "./GoogleService-Info.plist",
      "appleTeamId": "4UKF35QPZJ",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMotionUsageDescription": "걸음 수를 측정하기 위해 동작 센서 접근이 필요합니다."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.seoma.pedmeter",
      "versionCode": 14,
      "permissions": [
        "ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#071427",
        "foregroundImage": "./assets/images/school-logo.png",
        "monochromeImage": "./assets/images/school-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/school-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#071427",
          "dark": {
            "backgroundColor": "#071427"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.455472798685-9psh6i0sg7f53u4esab7d2koubm70583"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a7978fb-36d5-4c4b-8d9a-328a9e5e40ac"
      }
    }
  }
}
